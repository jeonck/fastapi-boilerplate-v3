# Environment Configuration
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Application Configuration
APP_NAME="FastAPI Boilerplate v3"
APP_VERSION="0.1.0"
APP_DESCRIPTION="FastAPI boilerplate with FastAPI Users, CrudRouter, Limiter and Cache"

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# Database Configuration (async driver URL)
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname  # needs asyncpg + psycopg

# Security Configuration (FastAPI Users) - CHANGE IN PRODUCTION!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (Optional) - shared backend for rate limiting & caching across workers
# When unset, in-memory backends are used (fine for a single process)
# REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration (FastAPI-Limiter)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_TIMES=60
RATE_LIMIT_SECONDS=60
AUTH_RATE_LIMIT_TIMES=10
AUTH_RATE_LIMIT_SECONDS=60

# Cache Configuration (FastAPI-Cache)
CACHE_ENABLED=True
CACHE_PREFIX=fastapi-cache
CACHE_EXPIRE_SECONDS=60

# Logging Configuration
LOG_LEVEL=INFO
